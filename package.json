{
  "name": "dsh-scoped-models",
  "version": "1.0.0",
  "description": "Keep only your chosen models in DSH's native model selectors, including dynamically registered subscription models.",
  "type": "module",
  "license": "MIT",
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.5" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": {"test": "node --test tests/*.test.js", "check": "node --check index.js && node --check core.js && node --check client.js && node --test tests/*.test.js"},
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-model-selection"]
    }
  }
}
